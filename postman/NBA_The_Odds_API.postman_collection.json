              "query": [
                {
                  "key": "apiKey",
                  "value": "{{api_key}}"
                },
                {
                  "key": "regions",
                  "value": "us"
                },
                {
                  "key": "markets",
                  "value": "spreads"
                },
                {
                  "key": "oddsFormat",
                  "value": "decimal"
                },
                {
                  "key": "dateFormat",
                  "value": "iso"
                }
              ]
            },
            "description": "Solo spreads (handicap). Útil para consultas que consumen menos quota."
