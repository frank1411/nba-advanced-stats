                {
                  "key": "dateFormat",
                  "value": "iso"
                }
              ]
            },
            "description": "Odds de múltiples regiones (US, US2, EU) para comparar líneas entre casas."
          }
        },
        {
          "name": "Odds NBA - Con Bookmakers Específicos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sports/{{sport}}/odds?apiKey={{api_key}}&regions=us&markets=h2h,spreads,totals&oddsFormat=decimal&dateFormat=iso&bookmakers=fanduel,draftkings,betmgm",
              "host": ["{{base_url}}"],
              "path": ["sports", "{{sport}}", "odds"],
              "query": [
                {
                  "key": "apiKey",
                  "value": "{{api_key}}"
                },
                {
                  "key": "regions",
                  "value": "us"
                },
                {
                  "key": "markets",
                  "value": "h2h,spreads,totals"
                },
                {
                  "key": "oddsFormat",
                  "value": "decimal"
                },
                {
                  "key": "dateFormat",
                  "value": "iso"
                },
                {
                  "key": "bookmakers",
                  "value": "fanduel,draftkings,betmgm",
                  "description": "Filtrar por casas específicas"
                }
              ]
            },
            "description": "Filtra por casas de apuestas específicas: FanDuel, DraftKings y BetMGM (las que usa el script de recomendaciones)."
          }
        }
      ]
    },
