{
  "info": {
    "_postman_id": "nba-odds-api-collection",
    "name": "🏀 NBA - The Odds API",
    "description": "Colección de endpoints de The Odds API para obtener líneas NBA.\n\nAPI Key configurada como variable de colección.\n\nEndpoints:\n- Sports disponibles\n- Odds NBA (H2H, Spreads, Totals)\n- Odds por evento específico\n- Scores/Resultados",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.the-odds-api.com/v4",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "TU_API_KEY",
      "type": "string"
    },
    {
      "key": "sport",
      "value": "basketball_nba",
      "type": "string"
    },
    {
      "key": "event_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "📋 Configuración",
      "item": [
        {
          "name": "Lista de Deportes Disponibles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sports?apiKey={{api_key}}",
              "host": ["{{base_url}}"],
              "path": ["sports"],
              "query": [
                {
                  "key": "apiKey",
                  "value": "{{api_key}}"
                }
              ]
            },
            "description": "Obtiene la lista de todos los deportes disponibles en la API, incluyendo los que están actualmente en temporada."
          }
        },
        {
          "name": "Verificar Uso de API (Quota)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sports/{{sport}}/odds?apiKey={{api_key}}&regions=us&markets=h2h",
              "host": ["{{base_url}}"],
              "path": ["sports", "{{sport}}", "odds"],
              "query": [
                {
                  "key": "apiKey",
                  "value": "{{api_key}}"
                },
                {
                  "key": "regions",
                  "value": "us"
                },
                {
                  "key": "markets",
                  "value": "h2h"
                }
              ]
            },
            "description": "Consulta mínima para verificar el uso de la API. Revisa los headers de respuesta:\n- x-requests-remaining: Solicitudes restantes\n- x-requests-used: Solicitudes usadas"
          }
        }
      ]
    },
    {
      "name": "🏀 NBA Odds",
      "item": [
        {
          "name": "Odds NBA Completas (H2H + Spreads + Totals)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sports/{{sport}}/odds?apiKey={{api_key}}&regions=us&markets=h2h,spreads,totals&oddsFormat=decimal&dateFormat=iso",
              "host": ["{{base_url}}"],
              "path": ["sports", "{{sport}}", "odds"],
              "query": [
                {
                  "key": "apiKey",
                  "value": "{{api_key}}"
                },
                {
                  "key": "regions",
                  "value": "us",
                  "description": "Regiones: us, us2, uk, au, eu"
                },
                {
                  "key": "markets",
                  "value": "h2h,spreads,totals",
                  "description": "Mercados: h2h (Moneyline), spreads (Handicap), totals (Over/Under)"
                },
                {
                  "key": "oddsFormat",
                  "value": "decimal",
                  "description": "Formato: decimal, american"
                },
                {
                  "key": "dateFormat",
                  "value": "iso",
                  "description": "Formato de fecha: iso, unix"
                }
              ]
            },
            "description": "⭐ ENDPOINT PRINCIPAL - Obtiene todas las odds NBA actuales.\n\nEste es el endpoint usado por 08_the_odds_api_recommendations.py para generar las recomendaciones diarias del Filtro 3.0.\n\nIncluye:\n- H2H (Moneyline): Quién gana\n- Spreads (Handicap): Ventaja/desventaja de puntos\n- Totals (Over/Under): Puntos totales del partido"
          }
        },
        {
          "name": "Odds NBA - Solo Spreads",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sports/{{sport}}/odds?apiKey={{api_key}}&regions=us&markets=spreads&oddsFormat=decimal&dateFormat=iso",
