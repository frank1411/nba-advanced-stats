                  "description": "En formato americano (+150, -110)"
                },
                {
                  "key": "dateFormat",
                  "value": "iso"
                }
              ]
            },
            "description": "Solo moneyline en formato americano (+150, -110)."
          }
        },
        {
          "name": "Odds NBA - Múltiples Regiones",
          "request": {
            "method": "GET",
            "header": [],
